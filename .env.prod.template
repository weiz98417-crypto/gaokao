# ============================================
# 高考志愿填报APP - 生产环境变量模板
# 复制为 .env.prod 并填入真实值
# 部署: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
# ============================================

# === 数据库 ===
DB_USER=gaokao
DB_PASSWORD=请修改为强密码
DB_NAME=gaokao

# === 前端地址（多个用逗号分隔）===
CORS_ORIGINS=https://your-domain.com

# === JWT 认证 ===
JWT_SECRET=请修改为至少32位的随机字符串
JWT_EXPIRES_IN=15m

# === 邮件服务（Brevo）===
BREVO_API_KEY=你的Brevo_API_Key
BREVO_FROM_EMAIL=your-email@example.com
BREVO_FROM_NAME=高考志愿填报系统

# === 大模型 API ===
USE_LLM=true
DEEPSEEK_API_KEY=你的DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# === 登录安全 ===
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
