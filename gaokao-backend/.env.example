# 后端服务端口
PORT=3000

# 允许的前端地址（多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173

# 数据库开关
# 设为 true 时使用 Prisma + PostgreSQL，否则使用内存 Mock
USE_DATABASE=true

# PostgreSQL 连接字符串（本地便携版，trust 认证）
DATABASE_URL="postgresql://gaokao@localhost:5432/gaokao?schema=public"

# 运行环境
NODE_ENV=development

# DeepSeek 大模型 API
USE_LLM=true
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# === 认证模块 ===
# JWT 签名密钥，至少 32 字符随机字符串
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# JWT 过期时间（如 15m / 1h / 7d）
JWT_EXPIRES_IN=15m

# SMTP 邮件服务器配置（QQ 邮箱示例）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM=your-email@qq.com

# 登录安全：最大尝试次数
LOGIN_MAX_ATTEMPTS=5

# 登录安全：超过尝试次数后的锁定时间（分钟）
LOGIN_LOCK_MINUTES=15
